{
  "uid": "lumen-embeddings",
  "title": "Lumen: embedding service",
  "tags": [
    "lumen",
    "llm"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Items / min by model",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "lumen-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "lumen-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) AS time, model, sum(items) AS items\n        FROM embedding_requests WHERE $__timeFilter(ts) GROUP BY time, model ORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cache hit rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "lumen-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "lumen-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) AS time, sum(cache_hits)/greatest(1,sum(items)) AS\n        hit_rate FROM embedding_requests WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency p95 (ms)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "lumen-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "lumen-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toStartOfMinute(ts) AS time, quantile(0.95)(compute_ms) AS p95\n        FROM embedding_requests WHERE $__timeFilter(ts) GROUP BY time ORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "lumen-clickhouse"
        },
        "query": "SELECT DISTINCT project_id FROM llm_hour",
        "refresh": 2
      }
    ]
  }
}