# Copy to .env. Never commit .env.
COMPOSE_PROFILES=cpu
LUMEN_IMAGE_TAG=dev
LUMEN_ENV=dev
LUMEN_LOG_LEVEL=INFO

POSTGRES_PASSWORD=lumen
CLICKHOUSE_PASSWORD=lumen
LUMEN_DATABASE_URL=postgresql+asyncpg://lumen:lumen@postgres:5432/lumen
LUMEN_REDIS_URL=redis://redis:6379/0
LUMEN_CLICKHOUSE_URL=http://lumen:lumen@clickhouse:8123/lumen
LUMEN_S3_ENDPOINT=minio:9000
LUMEN_S3_ACCESS_KEY=lumen
LUMEN_S3_SECRET_KEY=lumen-secret
LUMEN_S3_BUCKET=lumen

# security
LUMEN_BOOTSTRAP_TOKEN=change-me-bootstrap
GRAFANA_ADMIN_PASSWORD=change-me
# LUMEN_EMBED_API_KEY=        # optional bearer key for the embedder

# ingest / evals
LUMEN_CAPTURE_CONTENT=false   # true stores truncated prompt/response previews (needed for groundedness + drift)
LUMEN_EVAL_SAMPLE_RATE=0.1
LUMEN_JUDGE_URL=http://host.docker.internal:8090   # Atlas gateway (route `judge`) or any OpenAI-compatible API
LUMEN_JUDGE_ROUTE=judge
LUMEN_JUDGE_API_KEY=dev-internal-key

# alerts
# LUMEN_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# embeddings
LUMEN_EMBED_MAX_WAIT_MS=5
LUMEN_EMBED_MAX_BATCH_TOKENS=16384
LUMEN_RERANK_URL=http://tei-rerank:80
# LUMEN_OPENAI_API_KEY=

# OTel collector → Lumen (observability profile): an api key with the `ingest` scope
LUMEN_INGEST_KEY=
