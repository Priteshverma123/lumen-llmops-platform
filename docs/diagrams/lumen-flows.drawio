#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="290" width="175" height="56" as="geometry"/></mxCell><mxCell id="1. -fe-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -app-3" target="1. -span-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -span-4" target="1. -safe-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -safe-5" target="1. -norm-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -norm-6" target="1. -db-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -db-7" target="1. -dash-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -db-7" target="1. -alert-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fe-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="1. -db-7" target="1. -eval-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1. -fnote-18" value="&lt;font color=&quot;#b0b0b0&quot;&gt;Data is stored before it is acknowledged: nothing is lost if the database is briefly down.&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="2. User flow: ship a prompt"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#121212"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2. -ftitle-19" value="&lt;font color=&quot;#f2f2f2&quot;&gt;&lt;b&gt;Changing a prompt safely&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="2. -edit-20" value="&lt;b&gt;Edit prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;in the registry&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -ver-21" value="&lt;b&gt;New version saved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;old ones never change&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -test-22" value="&lt;b&gt;Run tests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;on a saved dataset&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -pass-23" value="&lt;b&gt;Passed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="697" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="2. -fix-24" value="&lt;b&gt;Fix and retry&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="685" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -ab-25" value="&lt;b&gt;A/B test&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;small share of real traffic&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -result-26" value="&lt;b&gt;Result?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2b2818;strokeColor=#a08a3c;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1127" y="178" width="150" height="80" as="geometry"/></mxCell><mxCell id="2. -stop-27" value="&lt;b&gt;Auto-stop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;harm detected → rollback&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#2b2020;strokeColor=#8a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1115" y="350.0" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -live-28" value="&lt;b&gt;Promote to production&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;apps pick it up within 60s&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1d2b1d;strokeColor=#4f8a4f;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="2. -fe-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -edit-20" target="2. -ver-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -ver-21" target="2. -test-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -test-22" target="2. -pass-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-32" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -pass-23" target="2. -fix-24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -fix-24" target="2. -edit-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-34" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -pass-23" target="2. -ab-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -ab-25" target="2. -result-26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-36" value="worse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -result-26" target="2. -stop-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fe-37" value="better" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#8a8f98;strokeWidth=1.5;fontColor=#c8c8c8;fontSize=11;fontStyle=2;labelBackgroundColor=#121212;" edge="1" parent="1" source="2. -result-26" target="2. -live-28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2. -fnote-38" value="&lt;font color=&quot;#b0b0b0&quot;&gt;Statistics are valid even if you check results every day (sequential testing).&lt;/font&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="450.0" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="3. User flow: cost spike"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#121212"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3. -ftitle-39" value="&lt;font color=&quot;#f2f2f2&quot;&gt;&lt;b&gt;Investigating a cost spike&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="3. -alert-40" value="&lt;b&gt;Alert fires&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;&gt;spend 3× normal&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#14332e;strokeColor=#2fbfa5;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -dash-41" value="&lt;b&gt;Open cost view&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#262626;strokeColor=#4a4a4a;fontColor=#f2f2f2;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="255" y="190" width="175" height="56" as="geometry"/></mxCell><mxCell id="3. -filter-42" value="&lt;b&gt;Narrow it down&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#9a9a9a&quot;