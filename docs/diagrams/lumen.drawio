" as="geometry"/></mxCell><mxCell id="8. -mget-170" value="Redis MGET (float16 vectors)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="420" height="80" as="geometry"/></mxCell><mxCell id="8. -sf-171" value="single-flight: identical in-flight texts share one future" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="355" width="420" height="54" as="geometry"/></mxCell><mxCell id="8. -mb-172" value="micro-batcher: queries before documents;&lt;br&gt;flush at padded-token budget or max_wait (5 ms)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="435" width="420" height="54" as="geometry"/></mxCell><mxCell id="8. -be-173" value="backend call (TEI /embed | OpenAI /embeddings)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="515" width="420" height="54" as="geometry"/></mxCell><mxCell id="8. -post-174" value="cache SET (TTL) · Matryoshka truncate · int8/binary" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="595" width="420" height="54" as="geometry"/></mxCell><mxCell id="8. -out-175" value="response + request row → ClickHouse (10 s batches)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="675" width="420" height="54" as="geometry"/></mxCell><mxCell id="8. -e-176" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block