-mget-170" target="8. -hit-183"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8. -why-185" value="&lt;b&gt;Why a wait window?&lt;/b&gt;&lt;br&gt;TEI&#x27;s queue is strict FIFO with no wait: bursty single-text traffic yields tiny batches. A few ms of wait trades little latency for much higher throughput (bench/batching_sweep.py). Queue full → 429 (backpressure)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="330" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-8" name="9. Deployment"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="9. -title-186" value="&lt;b&gt;Deployment: compose profiles; one image, many roles; one-shot migrations gate the apps&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="9. -p0-187" value="profile: &lt;b&gt;default&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="9. -d0-188" value="postgres · redis(noeviction) · clickhouse · minio · migrate-postgres · migrate-clickhouse · api · ingest · worker · embedder" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="760" height="60" as="geometry"/></mxCell><mxCell id="9. -p1-189" value="profile: &lt;b&gt;cpu&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="9. -d1-190" value="tei-embed (bge-small) · tei-rerank (bge-reranker-base)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="190" width="760" height="60" as="geometry"/></mxCell><mxCell id="9. -p2-191" value="profile: &lt;b&gt;gpu&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="60" as="geometry"/></mxCell><mxCell id="9. -d2-192" value="tei-embed-gpu (network alias tei-embed, NVIDIA reservation)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="280" width="760" height="60" as="geometry"/></mxCell><mxCell id="9. -p3-193" value="profile: &lt;b&gt;observability&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="200" height="60" as="geometry"/></mxCell><mxCell id="9. -d3-194" value="otel-collector (tail sampling, redaction) · grafana (ClickHouse datasource, dashboards-as-code)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="370" width="760" height="60" as="geometry"/></mxCell><mxCell id="9. -k8s-195" value="&lt;b&gt;Production notes&lt;/b&gt;&lt;br&gt;ClickHouse: managed or replicated cluster (ReplicatedMergeTree)&lt;br&gt;ingest consumers scale horizontally (consumer group)&lt;br&gt;embedder: HPA on queue depth; GPU nodes for TEI&lt;br&gt;S3 lifecycle rule replaces the retention cron" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="380" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-9" name="10. Code Module Map"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10.-title-196" value="&lt;b&gt;src/lumen: module dependencies (arrows = imports)&lt;/b&gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="10.-subtitle-197" value="Domain packages (telemetry, pricing, experiments, registry, evals, alerts, embeddings) never import api/." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="24" as="geometry"/></mxCell><mxCell id="10.-api-198" value="api/ (app, deps, routers)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="290" height="50" as="geometry"/></mxCell><mxCell id="10.-emb_app-199" value="embedder/ (app)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="290" height="50" as="geometry"/></mxCel